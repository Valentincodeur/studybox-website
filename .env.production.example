# Variables d'environnement pour la production (Vercel)
# À configurer dans Vercel Dashboard > Settings > Environment Variables

# Stripe Production Keys
# ⚠️ Utilisez vos clés LIVE (pk_live_ et sk_live_) pour la production
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_votre_cle_publique_live
STRIPE_SECRET_KEY=sk_live_votre_cle_secrete_live

# Instructions:
# 1. Allez sur https://dashboard.stripe.com/apikeys
# 2. Basculez en mode "Live" (pas Test)
# 3. Copiez vos clés de production
# 4. Ajoutez-les dans Vercel (pas dans ce fichier)
