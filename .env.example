# Stripe Configuration
# Obtenez vos clés API sur https://dashboard.stripe.com/apikeys

# Clé publique Stripe (commence par pk_test_ ou pk_live_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_votre_cle_publique_ici

# Clé secrète Stripe (commence par sk_test_ ou sk_live_)
# ⚠️ NE JAMAIS PARTAGER CETTE CLÉ PUBLIQUEMENT
STRIPE_SECRET_KEY=sk_test_votre_cle_secrete_ici

# Instructions:
# 1. Créez un compte sur https://stripe.com
# 2. Allez dans Développeurs > Clés API
# 3. Copiez la clé publique et la clé secrète
# 4. Créez un fichier .env.local à la racine du projet
# 5. Copiez ce contenu et remplacez les valeurs par vos vraies clés
# 6. Redémarrez le serveur de développement (npm run dev)
